PORT=4000

# How long a fetched market price is reused before calling the API again (seconds)
PRICE_CACHE_SECONDS=60

# Crypto live prices come from the CoinDCX public API (INR rate on CoinDCX); cached this long (seconds)
CRYPTO_PRICE_CACHE_SECONDS=10

# Indian gold price = international spot (COMEX, USD/oz) x USDINR / 31.1035 x (1 + duty%)
# Basic customs duty + AIDC on gold imports. Adjust if the government changes it.
GOLD_IMPORT_DUTY_PCT=6

# CoinGecko is used for coin search and as a fallback for coins not listed on CoinDCX.
# Optional: CoinGecko demo API key (higher rate limits). Leave empty for the public API.
COINGECKO_API_KEY=
