PORT=4000

# How long a fetched market price is reused before calling the API again (seconds)
PRICE_CACHE_SECONDS=60

# Crypto live prices come from the CoinDCX public API (INR rate on CoinDCX); cached this long (seconds)
CRYPTO_PRICE_CACHE_SECONDS=10

# Indian gold price = international spot (COMEX, USD/oz) x USDINR / 31.1035 x (1 + duty%)
# Basic customs duty + AIDC on gold imports. Adjust if the government changes it.
GOLD_IMPORT_DUTY_PCT=6

# CoinGecko is used for coin search and as a fallback for coins not listed on CoinDCX.
# Optional: CoinGecko demo API key (higher rate limits). Leave empty for the public API.
COINGECKO_API_KEY=

# ---- News & signals agent ----
# An LLM on Ollama Cloud reads recent headlines for each holding and flags stories likely to move the price.
# Create a key at https://ollama.com/settings/keys. Without one, stories are flagged by a keyword scan instead.
OLLAMA_API_KEY=
# Any Ollama Cloud model, e.g. gpt-oss:120b, gpt-oss:20b, deepseek-v3.1:671b, qwen3-coder:480b
OLLAMA_MODEL=gpt-oss:120b
# Point at your own Ollama server instead (no key needed), e.g. http://localhost:11434 with OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_HOST=https://ollama.com
# How often the brief is rebuilt for the same holdings (minutes), and how far back to look for headlines (days)
NEWS_CACHE_MINUTES=15
NEWS_LOOKBACK_DAYS=7

# ---- Chat assistant ----
# Uses the Ollama settings above. With OLLAMA_API_KEY set it searches and reads the web through
# Ollama's web search API; without a key it falls back to DuckDuckGo and direct page fetches.
# Model for the chat (must support tool calling); defaults to OLLAMA_MODEL.
CHAT_MODEL=
# Max rounds of tool use (searches, page reads, price lookups) per answer
CHAT_MAX_STEPS=8
